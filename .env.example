# ParlIQ MCP server configuration. Copy to .env and adjust as needed.
# All variables are optional - the defaults point at live production.

# ParlIQ API base URL. Defaults to the stable custom domain.
PARLIQ_API_URL=https://parliq.feldberg.co

# API key. The public read endpoints currently do not require one, so this can
# be left blank. Set it if ParlIQ starts enforcing auth on /api/mcp/*.
PARLIQ_API_KEY=

# Per-request timeout in milliseconds. Semantic search and AI report summaries
# can take a while, so the default is generous.
PARLIQ_TIMEOUT_MS=60000
